{
  "name": "better-qr",
  "version": "0.1.2",
  "description": "No-runtime-dependency TypeScript QR code generator with SVG rendering and optional center icons from your own.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/qr-code.d.ts",
    "dist/svg.d.ts",
    "dist/types.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.types.json",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "check": "npm run build && npm run coverage"
  },
  "keywords": [
    "qr",
    "qrcode",
    "iso-iec-18004",
    "svg",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wrknbuycnsmndie/better-qr"
  },
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@vitest/coverage-v8": "^4.1.4",
    "rollup": "^4.60.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.4"
  }
}
