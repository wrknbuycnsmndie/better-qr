{
  "name": "@better-qr/angular",
  "version": "0.2.0",
  "description": "Standalone Angular component for better-qr.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wrknbuycnsmndie/better-qr.git",
    "directory": "packages/angular"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "typecheck": "npm run build && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && vitest run"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "better-qr": "^0.2.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "better-qr": "file:../..",
    "jsdom": "^26.1.0",
    "ng-packagr": "^22.0.0",
    "rxjs": "^7.8.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.4",
    "zone.js": "~0.16.0"
  }
}
