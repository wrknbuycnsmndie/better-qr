{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "better-qr": ["../../dist/index.d.ts"],
      "better-qr/render-model": ["../../dist/render-model.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
